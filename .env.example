# コピーして .env を作成。実際の値はコミットしない。
DATABASE_PATH=./data/helpdesk.sqlite3
COOKIE_SECURE=false
ENABLE_DEMO=true
# 通常ログインは以下を設定した場合のみ利用可能（起動時に作成）。
# 既存ユーザーのパスワード変更は自動で行わない。
ADMIN_EMAIL=
ADMIN_PASSWORD=
EMPLOYEE_EMAIL=
EMPLOYEE_PASSWORD=
# 未設定なら無料・外部通信なしの「根拠抜粋モード」。AI生成とは表示しない。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=helpdesk-model
# LiteLLM Proxy経由でEmbeddingを使う場合。
EMBEDDING_MODEL=
AI_DAILY_LIMIT=30
SESSION_AI_LIMIT=8
# 概算単価を設定すると管理画面に費用を表示。未設定は「未設定」。
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
# Docker ComposeのLiteLLM Proxy用（モデル名と無料枠は登録時に公式で確認）。
GEMINI_API_KEY=
GEMINI_MODEL=
LITELLM_MASTER_KEY=
